{
  "id": "pf2e-line-template-fix",
  "title": "PF2e Line Template Fix",
  "description": "Fixes grid highlighting for the line (ray) template in the pf2e system: cells are picked by walking the grid along the center line, length follows the 5-10-5 diagonal movement rules, matching the official Paizo diagram.",
  "version": "0.3.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "esmodules": [
    "scripts/main.mjs"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    },
    {
      "lang": "ru",
      "name": "Русский",
      "path": "lang/ru.json"
    }
  ],
  "relationships": {
    "requires": [
      {
        "id": "lib-wrapper",
        "type": "module"
      }
    ]
  },
  "authors": [
    {
      "name": "def-gu",
      "url": "https://github.com/def-gu"
    }
  ],
  "url": "https://github.com/def-gu/pf2e-line-template-fix",
  "bugs": "https://github.com/def-gu/pf2e-line-template-fix/issues",
  "license": "LICENSE",
  "manifest": "https://github.com/def-gu/pf2e-line-template-fix/releases/latest/download/module.json",
  "download": "https://github.com/def-gu/pf2e-line-template-fix/releases/download/v0.3.0/module.zip"
}
