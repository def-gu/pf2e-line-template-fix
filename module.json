      { "id": "lib-wrapper", "type": "module" }
    ]
  },
  "authors": [
    { "name": "def-gu", "url": "https://github.com/def-gu" }
  ],
  "url": "https://github.com/def-gu/pf2e-line-template-fix",
  "bugs": "https://github.com/def-gu/pf2e-line-template-fix/issues",
